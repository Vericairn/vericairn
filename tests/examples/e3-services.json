          "/flow/pin/version": "1.0.0",
          "/flow/pin/hash": "${flowHash}",
          "/flow/complete": true,
          "/flow/steps/0/result/id": "${revision}",
          "/flow/steps/0/result/hash": "${revisionHash}",
          "/flow/steps/0/outputs/0/hash": "${revisedObject}",
          "/flow/steps/1/review/id": "${reapproval}",
          "/flow/steps/1/state": "done"
        }
      },
      "context": "restored"
    },
    {
      "id": "inspect-restored-review",
