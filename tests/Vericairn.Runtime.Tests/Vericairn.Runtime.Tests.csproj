<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Exercise evaluator contracts against real cultures, independently of the product's invariant host. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Vericairn.TestSupport" />
    <Compile Include="../TestSupport/ReleaseGateSource.cs" Link="TestSupport/ReleaseGateSource.cs" />
    <Compile Include="../TestSupport/FakeReleaseProvider.cs" Link="TestSupport/FakeReleaseProvider.cs" />
    <Compile Include="../TestSupport/SilentPeer.cs" Link="TestSupport/SilentPeer.cs" />
    <Compile Include="../TestSupport/SharedFileHash.cs" Link="TestSupport/SharedFileHash.cs" />
    <Compile Include="../TestSupport/RecordedNuGetHandler.cs" Link="TestSupport/RecordedNuGetHandler.cs" />
    <None Include="../TestSupport/NuGetFixtures/*.json" Link="NuGetFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Vericairn.Runtime/Vericairn.Runtime.csproj" />
    <ProjectReference Include="../../src/Vericairn.Sdk/Vericairn.Sdk.csproj" />
    <ProjectReference Include="../../src/Vericairn.Mcp/Vericairn.Mcp.csproj" />
    <ProjectReference Include="../../src/Vericairn.Adapters.Git/Vericairn.Adapters.Git.csproj" />
    <ProjectReference Include="../../src/Vericairn.Providers.GitHub/Vericairn.Providers.GitHub.csproj" />
    <ProjectReference Include="../../src/Vericairn.Providers.NuGet/Vericairn.Providers.NuGet.csproj" />
    <ProjectReference Include="../../src/Vericairn.Packs.Software/Vericairn.Packs.Software.csproj" />
    <ProjectReference Include="../../src/Vericairn.Records/Vericairn.Records.csproj" />
    <ProjectReference Include="../../src/Vericairn.Sdk/Vericairn.Sdk.csproj" />
    <ProjectReference Include="../Vericairn.Records.Tests/Vericairn.Records.Tests.csproj" />
  </ItemGroup>

</Project>
