<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Vericairn.TestSupport" />
    <Compile Include="../TestSupport/FakeReleaseProvider.cs" Link="TestSupport/FakeReleaseProvider.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The stand-in harness: started with its marker, the test executable behaves as a coding agent's harness and exits. -->
    <Compile Include="../Vericairn.Runtime.Tests/FakeHarness.cs" Link="FakeHarness.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Vericairn.Cli/Vericairn.Cli.csproj" />
    <ProjectReference Include="../../tools/Vericairn.DocsTool/Vericairn.DocsTool.csproj" />
    <ProjectReference Include="../../src/Vericairn.Records/Vericairn.Records.csproj" />
  </ItemGroup>

</Project>
