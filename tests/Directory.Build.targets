<Project>
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="Vericairn.TestSupport" />
    <Compile Include="$(MSBuildThisFileDirectory)TestSupport/TestTiming.cs" Link="TestSupport/TestTiming.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)TestSupport/ClientClock.cs" Link="TestSupport/ClientClock.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)TestSupport/MacFileNotifications.cs" Link="TestSupport/MacFileNotifications.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)TestSupport/TestPrerequisites.cs" Link="TestSupport/TestPrerequisites.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Vericairn.Runtime.Tests' Or '$(MSBuildProjectName)' == 'Vericairn.Daemon.Tests' Or '$(MSBuildProjectName)' == 'Vericairn.Cli.Tests'">
    <XunitAutoGeneratedEntryPoint>false</XunitAutoGeneratedEntryPoint>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Vericairn.Runtime.Tests'">
    <DefineConstants>$(DefineConstants);PROCESS_HARNESS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(XunitAutoGeneratedEntryPoint)' == 'false'">
    <Using Include="$(RootNamespace).SelfRegisteredExtensions" Alias="TestExtensions" />
    <Compile Include="$(MSBuildThisFileDirectory)TestSupport/TestProgram.cs" Link="TestSupport/TestProgram.cs" />
  </ItemGroup>
</Project>
