<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The stand-in harness: started with its marker, the test executable behaves as a coding agent's harness and exits. -->
    <Compile Include="../Vericairn.Runtime.Tests/FakeHarness.cs" Link="FakeHarness.cs" />
    <Compile Include="../TestSupport/SilentPeer.cs" Link="TestSupport/SilentPeer.cs" />
    <Compile Include="../TestSupport/RecordedNuGetHandler.cs" Link="TestSupport/RecordedNuGetHandler.cs" />
    <None Include="../TestSupport/NuGetFixtures/*.json" Link="NuGetFixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../TestSupport/CompanionWriteFixture.cs" Link="TestSupport/CompanionWriteFixture.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Vericairn.Daemon/Vericairn.Daemon.csproj" />
    <ProjectReference Include="../../src/Vericairn.Sdk/Vericairn.Sdk.csproj" />
    <ProjectReference Include="../../src/Vericairn.Runtime/Vericairn.Runtime.csproj" />
    <ProjectReference Include="../../src/Vericairn.Records/Vericairn.Records.csproj" />
    <ProjectReference Include="../Vericairn.Records.Tests/Vericairn.Records.Tests.csproj" />
    <ProjectReference Include="../Vericairn.Runtime.Tests/Vericairn.Runtime.Tests.csproj" />
  </ItemGroup>

</Project>
