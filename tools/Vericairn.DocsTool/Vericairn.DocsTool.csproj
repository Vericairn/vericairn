<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>vericairn-docs</AssemblyName>
    <RootNamespace>Vericairn.DocsTool</RootNamespace>
    <Description>Vericairn's build tooling for a release's documentation set; not part of any distributable.</Description>
    <IsPackable>false</IsPackable>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <None Update="workflow-inputs.rb" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../.github/scripts/check-workflow-actions.rb" Link="check-workflow-actions.rb" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vericairn.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Vericairn.Cli/Vericairn.Cli.csproj" />
    <ProjectReference Include="../../src/Vericairn.Protocol/Vericairn.Protocol.csproj" />
    <ProjectReference Include="../../src/Vericairn.Records/Vericairn.Records.csproj" />
  </ItemGroup>

</Project>
