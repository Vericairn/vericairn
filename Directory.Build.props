<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <!-- Only the applications restore the distributables' locked platform graphs. Without RuntimeIdentifiers, project
         references build libraries portably: a platform name in their intermediate path changes generated source and MVIDs.
         OutputType is declared after these props, so identify the two applications by project name here.
         Distributable lock files also pin the single-file analyzer for libraries; ordinary builds keep packages.lock.json. -->
    <RuntimeIdentifiers Condition="'$(VericairnDistributable)' == 'true' And ('$(MSBuildProjectName)' == 'Vericairn.Cli' Or '$(MSBuildProjectName)' == 'Vericairn.Workbench')">linux-x64;linux-arm64;osx-x64;osx-arm64;win-x64;win-arm64</RuntimeIdentifiers>
    <NuGetLockFilePath Condition="'$(VericairnDistributable)' == 'true'">$(MSBuildProjectDirectory)/packages.distributable.lock.json</NuGetLockFilePath>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Authors>Jason Furr</Authors>
    <Company>Vericairn</Company>
    <Product>Vericairn</Product>
    <Copyright>Copyright (c) 2026 Jason Furr</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Vericairn/vericairn</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>package-icon.png</PackageIcon>
    <PackageTags>vericairn;community;records;sdk;cli</PackageTags>
    <RepositoryUrl>https://github.com/Vericairn/vericairn</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Source Link is supplied by the .NET SDK; no package reference is needed. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <VersionPrefix>0.9.3</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <!-- From 0.9.4 (ID-16, design/presence-sessions.md § 11): the release build (DIST-21) passes Vericairn's Developer ID team
         identifier, the release helper's code-signing identifier and the macOS major versions its candidate's signed helper was
         qualified on, separated by commas (for example 15,26). Without a team identifier, as in every build from source, the build is a
         development build: it opens no presence session and honors VERICAIRN_ENCLAVE_HELPER. A release build lists no macOS version
         until a qualification passes on it, and with none it opens no session anywhere. Release builds also start the runtime processes
         the command line launches with the .NET diagnostics channel off (DOTNET_EnableDiagnostics=0), the only configuration .NET reads
         it from. -->
    <VericairnTeamIdentifier Condition="'$(VericairnTeamIdentifier)' == ''"></VericairnTeamIdentifier>
    <VericairnEnclaveHelperIdentifier Condition="'$(VericairnEnclaveHelperIdentifier)' == ''">vericairn-enclave</VericairnEnclaveHelperIdentifier>
    <VericairnPresenceSessionMacOS Condition="'$(VericairnPresenceSessionMacOS)' == ''"></VericairnPresenceSessionMacOS>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Vericairn.Records'">
    <AssemblyMetadata Include="VericairnTeamIdentifier" Value="$(VericairnTeamIdentifier)" />
    <AssemblyMetadata Include="VericairnEnclaveHelperIdentifier" Value="$(VericairnEnclaveHelperIdentifier)" />
    <AssemblyMetadata Include="VericairnPresenceSessionMacOS" Value="$(VericairnPresenceSessionMacOS)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)docs/nuget-readme.md" Pack="true" PackagePath="/README.md" />
    <None Include="$(MSBuildThisFileDirectory)brand/package-icon.png" Pack="true" PackagePath="/package-icon.png" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
