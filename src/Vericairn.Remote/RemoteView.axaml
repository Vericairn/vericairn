<!-- Remote's one view: pairing at first use, then the home's five areas for the selected estate. Every status is text, never colour
     alone; every input and command has a screen-reader name; long text wraps rather than truncating. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Vericairn.Remote"
             xmlns:p="using:Vericairn.Presentation"
             x:Class="Vericairn.Remote.RemoteView"
             x:DataType="vm:RemoteViewModel"
             Background="{DynamicResource BrandSurface}"
             FontSize="{DynamicResource ControlContentThemeFontSize}">
  <UserControl.Styles>
    <Style Selector="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource BrandText}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource BrandTextMuted}" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="FontSize" Value="{DynamicResource RemoteHeadingFontSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource BrandSurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrandOutline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Margin="12,8,12,4" Spacing="6">
      <TextBlock Classes="muted" FontSize="{DynamicResource RemoteSmallFontSize}" Text="{x:Static vm:RemoteViewModel.BuildLabel}" />
      <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding ShowHome}">
        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" ItemsSource="{Binding Estates}" SelectedItem="{Binding Selected}"
                  AutomationProperties.Name="Estate">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RemoteEstate">
              <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                <TextBlock Classes="muted" FontSize="{DynamicResource RemoteSmallFontSize}" Text="{Binding Detail}" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="1" Margin="8,0,0,0" Content="Refresh" Command="{Binding RefreshCommand}" AutomationProperties.Name="Refresh this estate" />
        <Button Grid.Column="2" Margin="8,0,0,0" Content="Add" Command="{Binding AddEstateCommand}" AutomationProperties.Name="Pair with another estate" />
      </Grid>
      <TextBlock x:Name="StatusText" IsVisible="{Binding ShowHome}" Text="{Binding StatusLine}" AutomationProperties.Name="{Binding StatusLine}" />
      <TextBlock Classes="muted" FontSize="{DynamicResource RemoteSmallFontSize}" IsVisible="{Binding ShowHome}" Text="{Binding ConnectionMessage}" />
      <TextBlock IsVisible="{Binding ShowHome}" Text="{Binding ObservationAge}" AutomationProperties.Name="Observation age" />
      <TextBlock x:Name="HistoryText" IsVisible="{Binding ShowHome}" Text="{Binding History}" TextWrapping="Wrap" AutomationProperties.Name="History checkpoints" />
      <TextBlock IsVisible="{Binding ShowHome}" Text="{Binding DetailMessage}" />
      <TextBlock IsVisible="{Binding ShowHome}" Text="{Binding CacheMessage}" />
      <TextBlock IsVisible="{Binding ShowHome}" Text="{Binding DecisionStorageProblem}" />
      <TextBlock IsVisible="{Binding ObservationUnavailable}" Text="This estate has not been observed. Refresh to read it; an unavailable view says nothing about its work or attention." />
      <Expander Header="Communication" IsVisible="{Binding ShowHome}" AutomationProperties.Name="Read-only communication settings">
        <ScrollViewer MaxHeight="240">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Communication}" />
            <TextBlock Text="{x:Static vm:RemoteViewModel.WorkLater}" />
          </StackPanel>
        </ScrollViewer>
      </Expander>
    </StackPanel>

    <ScrollViewer Grid.Row="1" IsVisible="{Binding Pairing}">
      <StackPanel Margin="12" Spacing="10">
        <TextBlock Classes="heading" Text="Pair with an estate" />
        <TextBlock Text="{x:Static vm:RemoteViewModel.Companion}" />
        <TextBlock Classes="muted" Text="{x:Static vm:RemoteViewModel.PairingHelp}" />
        <TextBlock Text="Runtime address" />
        <TextBox x:Name="AddressBox" Text="{Binding Address}" PlaceholderText="192.168.1.20:7443" AutomationProperties.Name="Runtime address, host and port" />
        <TextBlock Text="Pairing code" />
        <TextBox x:Name="CodeBox" Text="{Binding Code}" PlaceholderText="One-time code" AutomationProperties.Name="Pairing code" />
        <TextBlock Text="This phone's name" />
        <TextBox x:Name="NameBox" Text="{Binding DeviceName}" AutomationProperties.Name="This phone's name on the estate" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="PairButton" Content="Pair" Command="{Binding PairCommand}" AutomationProperties.Name="Pair with this runtime" />
          <Button Content="Cancel" Command="{Binding CancelPairingCommand}" IsVisible="{Binding HasEstates}" AutomationProperties.Name="Back to the home" />
        </StackPanel>
        <TextBlock x:Name="PairingResult" Text="{Binding PairingMessage}" />
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Row="1" x:Name="PolicyScroll" IsVisible="{Binding HasPolicyDetail}">
      <StackPanel Margin="12" Spacing="10">
        <Button Content="Back to attention" Command="{Binding ClosePolicyCommand}" AutomationProperties.Name="Leave policy inspection without sending a request" />
        <TextBlock Classes="heading" Text="Policy condition and duty history" />
        <TextBlock Text="{Binding PolicyDestination}" AutomationProperties.Name="Policy estate, runtime and principal" />
        <TextBlock Text="{Binding PolicyFreshness}" AutomationProperties.Name="Policy observation time and age" />
        <TextBlock Text="{Binding PolicyMessage}" />
        <TextBlock x:Name="PolicyMaterial" Text="{Binding PolicyDetail.Material}" AutomationProperties.Name="Exact condition, occurrences, completion proofs and exception history" />
        <Expander Header="Evaluation basis" AutomationProperties.Name="Complete observed policy evaluation inputs">
          <TextBlock Text="{Binding PolicyDetail.EvaluationBasis}" />
        </Expander>
        <TextBlock Text="{Binding PolicyAuthority}" />
        <TextBlock Text="{Binding PolicyDetail.DesktopRoute}" AutomationProperties.Name="Exact subject and desktop review route" />
        <TextBlock Text="This inspection grants no approval or effect. Acknowledgment does not discharge a duty. Review and any action require the desktop's current material and authority." />
        <WrapPanel Orientation="Horizontal">
          <Button Content="Refresh policy" Command="{Binding RefreshPolicyCommand}" AutomationProperties.Name="Refresh the policy basis and authority without writing" />
          <Button Content="Prepare desktop handoff" Command="{Binding PolicyHandoffCommand}" AutomationProperties.Name="Read desktop context for the exact original subject without approving or writing" />
        </WrapPanel>
        <Expander Header="Desktop context and original material" AutomationProperties.Name="Complete desktop handoff or refusal">
          <TextBlock Text="{Binding PolicyHandoff}" />
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <ScrollViewer Grid.Row="1" x:Name="DecisionScroll" IsVisible="{Binding HasDecisionReview}">
      <StackPanel Margin="12" Spacing="10">
        <Button Content="Back to home" Command="{Binding CloseDecisionCommand}" AutomationProperties.Name="Leave this review and retain the draft or original submission" />
        <TextBlock Classes="heading" Text="Decision review" />
        <TextBlock Text="{Binding DecisionTarget}" AutomationProperties.Name="Decision estate, runtime, person and phone device" />
        <TextBlock Text="{Binding DecisionIdentity}" AutomationProperties.Name="Exact reviewed revision, hash and freshness" />
        <TextBlock Text="{Binding DecisionQuestion}" />
        <ComboBox x:Name="DecisionOptions" ItemsSource="{Binding DecisionOptions}" SelectedItem="{Binding SelectedDecisionOption}"
                  IsVisible="{Binding IsAsk}" IsEnabled="{Binding CanEditDecision}" HorizontalAlignment="Stretch" AutomationProperties.Name="Choose an answer's exact words without submitting">
          <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock FontWeight="SemiBold" Text="Complete review material, reviews and evidence" />
        <TextBlock x:Name="DecisionMaterial" Text="{Binding DecisionMaterial}" />
        <Expander Header="Original draft material" AutomationProperties.Name="Original subject retained with this draft">
          <TextBlock Text="{Binding OriginalDecisionMaterial}" />
        </Expander>
        <TextBlock Text="Your answer or acceptance statement" />
        <TextBox x:Name="DecisionStatement" Text="{Binding DecisionStatement}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                 IsEnabled="{Binding CanEditDecision}" AutomationProperties.Name="Your exact answer or acceptance statement, saved as a draft" />
        <StackPanel IsVisible="{Binding IsAsk}" Spacing="6" IsEnabled="{Binding CanEditDecision}">
          <TextBlock Text="How much rides on this decision" />
          <ComboBox ItemsSource="{x:Static vm:RemoteViewModel.DecisionStakes}" SelectedItem="{Binding DecisionStake}" AutomationProperties.Name="Decision stake" />
          <TextBlock Text="Estate basis, as the runtime supplied it" />
          <TextBlock x:Name="DecisionBasis" Text="{Binding DecisionBasis}" AutomationProperties.Name="The estate head commit and design document changes the runtime supplied for this answer" />
        </StackPanel>
        <TextBlock FontWeight="SemiBold" Text="Proposed record" />
        <TextBlock Text="Your words are recorded verbatim. An answer's summary, synthesis and effect use those same words. The runtime supplies its record identity and authoring time. No external action is dispatched." />
        <TextBlock Text="{Binding DecisionPreview}" />
        <CheckBox IsChecked="{Binding MaterialReviewed}" IsEnabled="{Binding CanEditDecision}" AutomationProperties.Name="Confirm review of this exact subject, evidence and proposed record">
          <TextBlock Text="I reviewed this exact revision, all material above and the proposed record." />
        </CheckBox>
        <TextBlock x:Name="DecisionEligibility" Text="{Binding DecisionEligibility}" />
        <StackPanel x:Name="PresenceKeyPanel" IsVisible="{Binding NeedsPresenceKey}" Spacing="6">
          <TextBlock FontWeight="SemiBold" Text="Add this phone's presence key" />
          <TextBlock Classes="muted" Text="{x:Static vm:RemoteViewModel.PresenceHelp}" />
          <TextBox x:Name="PresenceCodeBox" Text="{Binding PresenceCode}" PlaceholderText="One-time code for this person" AutomationProperties.Name="Pairing code that adds this phone's presence key" />
          <Button x:Name="AddPresenceKey" Content="Add presence key" Command="{Binding AddPresenceKeyCommand}" AutomationProperties.Name="Add a presence key to this connection; it asks for your presence once" />
          <TextBlock Text="{Binding PresenceMessage}" AutomationProperties.Name="What adding the presence key observed" />
        </StackPanel>
        <WrapPanel Orientation="Horizontal">
          <Button Content="Refresh review" Command="{Binding RefreshDecisionCommand}" AutomationProperties.Name="Read current decision material without submitting" />
          <Button x:Name="SignDecision" Content="Sign and submit" Command="{Binding SubmitDecisionCommand}" AutomationProperties.Name="Sign the reviewed answer or acceptance once with this phone's presence key, which asks for your presence" />
          <Button Content="Reconcile" Command="{Binding ReconcileDecisionCommand}" AutomationProperties.Name="Read the original submitted record without resending" />
          <Button Content="Defer" Command="{Binding DeferDecisionCommand}" AutomationProperties.Name="Defer by acknowledging this notice only" />
          <Button Content="Request changes" Command="{Binding RequestDecisionChangesCommand}" AutomationProperties.Name="Show the desktop route for requesting changes" />
        </WrapPanel>
        <TextBlock x:Name="DecisionOutcome" Text="{Binding DecisionMessage}" AutomationProperties.Name="Observed submission outcome" />
        <TextBlock Text="{Binding DecisionReceipt}" />
      </StackPanel>
    </ScrollViewer>

    <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedArea}" x:Name="Home" IsVisible="{Binding ShowAreas}" TabStripPlacement="Bottom">
      <TabItem Header="Attention" AutomationProperties.Name="Attention">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer Grid.Row="0">
            <StackPanel Margin="12" Spacing="6">
              <TextBlock Classes="muted" IsVisible="{Binding AttentionEmpty}" Text="Nothing needs attention in the last observation. The absence of notices never proves the absence of issues; refresh to check." />
              <ListBox x:Name="AttentionList" ItemsSource="{Binding Attention}" SelectedItem="{Binding SelectedAttention}" AutomationProperties.Name="Attention">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="p:AttentionItem">
                    <Border Classes="card">
                      <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource BrandAttention}" Text="{Binding KindLabel}" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding Subject}" />
                        <TextBlock Text="{Binding Why}" />
                        <TextBlock Classes="muted" Text="{Binding State, StringFormat='State: {0}'}" />
                        <TextBlock Text="{Binding AttentionDescription}" />
                        <TextBlock Classes="muted" Text="{Binding NextAction, StringFormat='Next: {0}'}" />
                        <TextBlock Classes="muted" FontSize="{DynamicResource RemoteSmallFontSize}" Text="{Binding AsOf, StringFormat='As of {0}'}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock FontWeight="SemiBold" IsVisible="{Binding HasStops}" Text="Stops of runs: what waits on a person" />
              <TextBlock Classes="muted" IsVisible="{Binding HasStops}" Text="{Binding StopsAsOf}" TextWrapping="Wrap" />
              <ListBox ItemsSource="{Binding Stops}" IsVisible="{Binding HasStops}" AutomationProperties.Name="Stops of runs, with the operator's next reserved step">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="p:StopRow">
                    <Border Classes="card">
                      <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource BrandAttention}" Text="{Binding KindLabel}" TextWrapping="Wrap" />
                        <TextBlock FontWeight="SemiBold" Text="{Binding Heading}" TextWrapping="Wrap" />
                        <SelectableTextBlock MinHeight="24" Text="{Binding Detail}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock FontWeight="SemiBold" Text="Local drafts and original submissions" />
              <ListBox ItemsSource="{Binding DecisionDrafts}" SelectedItem="{Binding SelectedDraft}" AutomationProperties.Name="Drafts and submissions for this exact phone connection">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RemoteDecisionDraft"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Content="Open retained draft or submission" Command="{Binding OpenDraftCommand}" AutomationProperties.Name="Open the retained original without sending it" />
              <TextBlock Text="{Binding DecisionMessage}" />
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="1" Margin="12,4,12,8" Spacing="6">
            <WrapPanel Orientation="Horizontal">
              <Button Content="Open subject" Command="{Binding OpenAttentionCommand}" AutomationProperties.Name="Open the selected attention subject" />
              <Button Margin="8,0,0,0" Content="Acknowledge" Command="{Binding AcknowledgeCommand}" AutomationProperties.Name="Acknowledge the selected notice without changing work" />
            </WrapPanel>
            <TextBlock Classes="muted" FontSize="{DynamicResource RemoteSmallFontSize}" Text="{x:Static vm:RemoteViewModel.AttentionLater}" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="Work" AutomationProperties.Name="Work">
        <ScrollViewer x:Name="WorkScroll">
          <StackPanel Margin="12" Spacing="6">
            <StackPanel IsVisible="{Binding ShowWorkList}" Spacing="6">
              <TextBlock Classes="muted" IsVisible="{Binding WorkEmpty}" Text="No open work in the last observation." />
              <ListBox x:Name="WorkList" ItemsSource="{Binding Work}" SelectedItem="{Binding SelectedWork}" AutomationProperties.Name="Work">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="p:WorkOrderRow">
                    <Border Classes="card">
                      <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Key}" />
                        <TextBlock Text="{Binding Title}" />
                        <TextBlock Classes="muted" Text="{Binding StatusLabel}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Content="Open work" Command="{Binding OpenWorkCommand}" AutomationProperties.Name="Open the selected work order" />
              <ListBox x:Name="AssignmentList" ItemsSource="{Binding Assignments}" SelectedItem="{Binding SelectedAssignment}" AutomationProperties.Name="Assignments">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:AssignmentItem">
                    <Border Classes="card">
                      <StackPanel Spacing="2">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Key, StringFormat='Assignment of {0}'}" />
                        <TextBlock Text="{Binding Contributor}" />
                        <TextBlock Classes="muted" Text="{Binding State}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Content="Open assignment" Command="{Binding OpenAssignmentCommand}" AutomationProperties.Name="Open the selected assignment" />
            </StackPanel>
            <Border Classes="card" IsVisible="{Binding HasWorkDetail}">
              <StackPanel x:Name="WorkDetailPanel" Spacing="8">
                <Button Content="Back to work" Command="{Binding BackToWorkCommand}" AutomationProperties.Name="Back to the work list" />
                <TextBlock Classes="heading" Text="{Binding WorkDetail.Title}" />
                <TextBlock Text="{Binding DetailFreshness}" AutomationProperties.Name="Work detail freshness" />
                <TextBlock Text="{Binding WorkDetail.Goal}" />
                <TextBlock FontWeight="SemiBold" Text="Admitted scope" />
                <TextBlock Text="{Binding WorkDetail.Scope}" />
                <TextBlock FontWeight="SemiBold" Text="Latest result" />
                <TextBlock Text="{Binding WorkDetail.LatestResult}" />
                <TextBlock FontWeight="SemiBold" Text="Attempts and results" />
                <TextBlock Text="{Binding WorkDetail.History}" />
                <TextBlock FontWeight="SemiBold" Text="Runs and worker observations" />
                <TextBlock Text="{Binding RunObservations}" />
                <TextBlock FontWeight="SemiBold" Text="Agent progress claims beside worker observations" />
                <TextBlock Text="{Binding ProgressClaims}" />
              </StackPanel>
            </Border>
            <TextBlock Classes="muted" FontSize="{DynamicResource RemoteSmallFontSize}" Text="{x:Static vm:RemoteViewModel.WorkLater}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Products" AutomationProperties.Name="Products">
        <ScrollViewer>
          <ItemsControl x:Name="ProductList" Margin="12" ItemsSource="{Binding Products}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ProductItem">
                <Border Classes="card">
                  <StackPanel Spacing="2">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                    <TextBlock Classes="muted" FontSize="{DynamicResource RemoteSmallFontSize}" Text="{Binding Id}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Nodes" AutomationProperties.Name="Nodes">
        <ScrollViewer>
          <StackPanel Margin="12" Spacing="4" x:Name="NodePanel">
            <TextBlock Classes="heading" Text="{Binding Node.Estate, FallbackValue=''}" />
            <TextBlock Text="{Binding Node.State, StringFormat='Connection: {0}', FallbackValue=''}" />
            <TextBlock Text="{Binding Node.Message, FallbackValue=''}" />
            <TextBlock Text="{Binding Node.Address, StringFormat='Address: {0}', FallbackValue=''}" />
            <TextBlock Text="{Binding Node.Runtime, StringFormat='Runtime identity: {0}', FallbackValue=''}" />
            <TextBlock Text="{Binding Node.ActingAs, StringFormat='Acting as: {0}', FallbackValue=''}" />
            <TextBlock Text="{Binding Node.Device, StringFormat='Device of this phone: {0}', FallbackValue=''}" />
            <TextBlock Text="{Binding Node.Profiles, StringFormat='Profiles: {0}', FallbackValue=''}" />
            <TextBlock Text="{Binding Node.PairedAt, StringFormat='Paired: {0}', FallbackValue=''}" />
            <TextBlock Text="{Binding Node.LastCurrent, StringFormat='Last current: {0}', FallbackValue=''}" />
            <TextBlock Classes="muted" FontSize="{DynamicResource RemoteSmallFontSize}" Text="{x:Static vm:RemoteViewModel.NodesNote}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Handoffs" AutomationProperties.Name="Handoffs">
        <TextBlock Margin="12" Text="{x:Static vm:RemoteViewModel.HandoffsLater}" />
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
