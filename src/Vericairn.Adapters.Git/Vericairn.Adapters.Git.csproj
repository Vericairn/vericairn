<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>The git adapter (vericairn.adapter.git): read-only repository observation and isolated worker workspaces over the git command. Shipped inside Vericairn Community until packages exist.</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="vericairn" />
    <InternalsVisibleTo Include="Vericairn.Runtime.Tests" />
    <ProjectReference Include="../Vericairn.Runtime/Vericairn.Runtime.csproj" />
    <ProjectReference Include="../Vericairn.Records/Vericairn.Records.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The secret scan's configuration: gitleaks' default rules without their built-in allowlists, and Vericairn's own allowances. -->
    <EmbeddedResource Include="gitleaks.toml" LogicalName="Vericairn.Adapters.Git.gitleaks.toml" />
  </ItemGroup>

</Project>
