<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Vericairn.Workbench"
        xmlns:pres="using:Vericairn.Presentation"
        xmlns:proto="using:Vericairn.Protocol"
        x:Class="Vericairn.Workbench.MainWindow"
        x:DataType="local:ShellViewModel"
        Title="Vericairn Workbench" Width="1200" Height="800" MinWidth="720" MinHeight="480"
        Background="{DynamicResource BrandSurface}" Foreground="{DynamicResource BrandText}" FontFamily="{DynamicResource BrandBodyFont}">
  <DockPanel>
    <Menu DockPanel.Dock="Top" Name="MainMenu" AutomationProperties.Name="Main menu">
      <MenuItem Header="_Estate">
        <MenuItem Header="_Open or connect" InputGesture="Ctrl+O" Click="OnFocusOpen" />
        <MenuItem Header="_Refresh" InputGesture="F5" Click="OnRefresh" />
        <MenuItem Name="CommunicationMenu" Header="_Communication settings" Click="OnOpenCommunication" />
        <MenuItem Header="Record my _observation of the estate" Click="OnObserveEstate" />
      </MenuItem>
      <MenuItem Header="_Runtime" Name="RuntimeMenu">
        <MenuItem Header="_Start the daemon" Click="OnStartRuntime" />
        <MenuItem Header="S_top the daemon" Click="OnStopRuntime" />
        <MenuItem Header="Show the _install plan" Click="OnInstallPlan" />
        <MenuItem Header="_Install the per-user service (after the plan)" Click="OnInstallRuntime" />
        <MenuItem Header="_Uninstall the per-user service (after the plan)" Click="OnUninstallRuntime" />
      </MenuItem>
      <MenuItem Header="_Work">
        <MenuItem Header="Result _inbox" InputGesture="Ctrl+I" Click="OnOpenInbox" />
        <MenuItem Header="_Products" Click="OnOpenProducts" />
        <MenuItem Header="Living _documents" InputGesture="Ctrl+Shift+D" Click="OnOpenLivingDocuments" />
        <MenuItem Header="Progress _report" InputGesture="Ctrl+Shift+P" Click="OnOpenProgress" />
        <MenuItem Header="_Hand-over and resume" InputGesture="Ctrl+Shift+H" Click="OnOpenHandoff" />
        <MenuItem Header="_Goals workspace" InputGesture="Ctrl+Shift+G" Click="OnOpenGoals" />
        <MenuItem Header="_Assign the open work order" InputGesture="Ctrl+Shift+A" Click="OnOpenComposer" />
        <MenuItem Header="_Compare the open record with its earlier revision" Click="OnCompareOpen" />
        <Separator />
        <MenuItem Header="R_elease workspace" InputGesture="Ctrl+Shift+E" Click="OnOpenRelease" />
        <MenuItem Header="R_untime workspace" InputGesture="Ctrl+Shift+U" Click="OnOpenRuntime" />
        <Separator />
        <MenuItem Header="_Send the open document's request" InputGesture="Ctrl+Enter" Click="OnPrimarySend" />
        <MenuItem Header="Send the open document's _second request (acceptance, observation)" InputGesture="Ctrl+Shift+Enter" Click="OnSecondarySend" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="Toggle _navigation" InputGesture="Ctrl+Shift+L" Click="OnToggleLeft" />
        <MenuItem Header="Toggle _inspector" InputGesture="Ctrl+Shift+R" Click="OnToggleRight" />
        <MenuItem Header="Toggle _activity" InputGesture="Ctrl+Shift+B" Click="OnToggleBottom" />
        <MenuItem Header="Reset _layout" InputGesture="Ctrl+Shift+0" Click="OnResetLayout" />
        <Separator />
        <MenuItem Header="Focus navigation" InputGesture="Ctrl+1" Click="OnFocusNavigation" />
        <MenuItem Header="Focus documents" InputGesture="Ctrl+2" Click="OnFocusDocuments" />
        <MenuItem Header="Focus inspector" InputGesture="Ctrl+3" Click="OnFocusInspector" />
        <MenuItem Header="Focus activity" InputGesture="Ctrl+4" Click="OnFocusActivity" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Top" Name="TargetBar" Padding="12,6" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" AutomationProperties.Name="Target context">
      <StackPanel Orientation="Horizontal" Spacing="18">
        <TextBlock Name="EstateNameText" Text="{Binding EstateName}" FontWeight="Bold" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Pin}" VerticalAlignment="Center" />
        <TextBlock Name="RuntimeText" Text="{Binding RuntimeLabel}" VerticalAlignment="Center" />
        <TextBlock Name="ActingText" Text="{Binding ActingPrincipal}" VerticalAlignment="Center" />
        <ComboBox Name="ActingBox" ItemsSource="{Binding ActingCandidates}" SelectedItem="{Binding SelectedActing}" MinHeight="28" MinWidth="160" IsVisible="{Binding HasEstate}" AutomationProperties.Name="Acting principal (admitted devices held here)">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="proto:DeviceRow">
              <TextBlock Text="{Binding PrincipalName}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Name="FreshnessText" Text="{Binding Freshness}" VerticalAlignment="Center" />
        <TextBox Name="RecordIdBox" PlaceholderText="Record id, then Enter" Width="300" MinHeight="28" AutomationProperties.Name="Open a record by id" />
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="12,6">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="{Binding RequestState}" VerticalAlignment="Center" AutomationProperties.Name="Request state" />
        <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Width="100" Height="4" VerticalAlignment="Center" />
        <Button Name="CancelRequestButton" Content="Cancel request" Command="{Binding CancelCommand}" MinHeight="28" AutomationProperties.Name="Cancel current request" />
        <Button Content="Refresh" Command="{Binding RefreshCommand}" MinHeight="28" />
      </StackPanel>
      <TextBlock Name="StatusBar" Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.Name="Status" />
      <SelectableTextBlock Text="{Binding UncertaintyNotice}" IsVisible="{Binding HasUncertainOutcomes}" TextWrapping="Wrap" AutomationProperties.Name="Effects needing reconciliation" />
    </StackPanel>

    <Border DockPanel.Dock="Top" Padding="12,6" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="0,0,0,1" AutomationProperties.Name="Machine-local release information">
      <StackPanel Spacing="4">
        <SelectableTextBlock Name="UpdateDisclosureText" Text="{Binding UpdateDisclosure}" MinHeight="24" TextWrapping="Wrap" Focusable="True" AutomationProperties.Name="Release check disclosure and setting" />
        <SelectableTextBlock Name="UpdateNoticeText" Text="{Binding UpdateNotice}" IsVisible="{Binding HasUpdateNotice}" MinHeight="24" TextWrapping="Wrap" Focusable="True" AutomationProperties.Name="Newer release and upgrade instructions" />
      </StackPanel>
    </Border>

    <Grid Name="Body" ColumnDefinitions="240,4,*,4,320" RowDefinitions="*,4,160">
      <Border Name="LeftPanel" Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding LeftVisible}" AutomationProperties.Name="Navigation">
        <ListBox Name="Navigation" Focusable="True" ItemsSource="{Binding Regions}" SelectedItem="{Binding SelectedRegion}" AutomationProperties.Name="Primary navigation">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="local:Region">
              <StackPanel MinHeight="32">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Question}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>
      <GridSplitter Name="LeftSplitter" Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Width="4" IsVisible="{Binding LeftVisible}" />

      <Grid Grid.Column="2" Grid.Row="0" RowDefinitions="Auto,*">
        <StackPanel Name="FirstRun" Grid.Row="0" Margin="16" Spacing="8" IsVisible="{Binding !HasEstate}" AutomationProperties.Name="Open an estate">
          <!-- The identity: the cairn mark drawn as geometry (brand/cairn-mark.svg at half scale) and the wordmark in the title face. -->
          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,8">
            <Canvas Width="32" Height="32" AutomationProperties.Name="Vericairn mark">
              <Border Canvas.Left="4.5" Canvas.Top="23" Width="23" Height="5" CornerRadius="1.75" Background="{DynamicResource BrandAccent}" />
              <Border Canvas.Left="8.5" Canvas.Top="16.5" Width="17" Height="5" CornerRadius="1.75" Background="{DynamicResource BrandAccent}" />
              <Border Canvas.Left="6.5" Canvas.Top="10" Width="15" Height="5" CornerRadius="1.75" Background="{DynamicResource BrandAccent}" />
              <Border Canvas.Left="12" Canvas.Top="4" Width="9" Height="4.5" CornerRadius="1.75" Background="{DynamicResource BrandAccent}" />
            </Canvas>
            <TextBlock Text="Vericairn" FontFamily="{DynamicResource BrandTitleFont}" FontWeight="SemiBold" FontSize="26" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Open an estate" FontSize="20" FontWeight="SemiBold" FontFamily="{DynamicResource BrandHeadingFont}" />
          <TextBlock TextWrapping="Wrap" Text="Create locally, adopt existing work, or connect to an authorized estate. In this release Workbench opens an existing estate's root; creation and adoption follow with the work screens. Records stay in that directory and nothing leaves this machine unless a provider you connect sends it." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Name="EstatePathBox" Width="520" MinHeight="32" PlaceholderText="Path of the estate root (the directory with estate/manifest.json)" Text="{Binding EstatePath}" AutomationProperties.Name="Estate root" />
            <Button Name="OpenButton" Content="Open" MinHeight="32" MinWidth="80" Click="OnOpenEstate" />
          </StackPanel>
          <TextBlock Text="Recent" FontWeight="SemiBold" Margin="0,8,0,0" />
          <ListBox Name="RecentList" Focusable="True" ItemsSource="{Binding Recent}" MaxHeight="200" AutomationProperties.Name="Recent estates" DoubleTapped="OnRecentOpen" />
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,*" IsVisible="{Binding HasEstate}">
          <Border Grid.Row="0" IsVisible="{Binding HomeSelected}" Padding="8" AutomationProperties.Name="Home">
            <StackPanel Spacing="4">
              <TextBlock Text="Attention" FontWeight="SemiBold" />
              <ListBox Name="AttentionList" Focusable="True" ItemsSource="{Binding Attention}" MaxHeight="360" AutomationProperties.Name="Attention items" DoubleTapped="OnAttentionOpen" SelectionChanged="OnAttentionSelected">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="pres:AttentionItem">
                    <Grid ColumnDefinitions="150,*" MinHeight="32">
                      <TextBlock Grid.Column="0" Text="{Binding KindLabel}" FontWeight="SemiBold" Foreground="{DynamicResource BrandAttention}" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Subject}" />
                        <TextBlock Text="{Binding Why}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Progress, from the records (Enter opens the report)" FontWeight="SemiBold" Margin="0,8,0,0" />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="This status view's depth" VerticalAlignment="Center" />
                <ComboBox ItemsSource="{Binding StatusViewDepths}" SelectedItem="{Binding StatusViewDepth}" MinWidth="160" AutomationProperties.Name="One-view status depth" />
              </StackPanel>
              <Expander Header="Current status and communication" IsExpanded="False">
                <ScrollViewer MaxHeight="240">
                  <SelectableTextBlock Text="{Binding HumanStatus}" TextWrapping="Wrap" Focusable="True" AutomationProperties.Name="Personalized current status" />
                </ScrollViewer>
              </Expander>
              <Button Content="Communication settings" Click="OnOpenCommunication" MinHeight="28" HorizontalAlignment="Left" />
              <ListBox Name="ProgressList" Focusable="True" ItemsSource="{Binding Progress}" MaxHeight="280" AutomationProperties.Name="Progress summary" DoubleTapped="OnOpenProgress">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="pres:ProgressRow">
                    <Grid ColumnDefinitions="180,*" MinHeight="32">
                      <TextBlock Grid.Column="0" Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Text="{Binding Detail}" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Button Name="ProgressButton" Content="Open the progress report" MinHeight="28" HorizontalAlignment="Left" Click="OnOpenProgress" />
              <SelectableTextBlock MinHeight="24" Text="{Binding LastPersonObservation}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.Name="Last human observation" />
              <WrapPanel>
                <Button Name="HandoffButton" Content="Hand-over and resume" MinHeight="28" Margin="0,0,8,0" Click="OnOpenHandoff" />
                <Button Name="ObserveEstateButton" Content="Record my observation" MinHeight="28" Click="OnObserveEstate" />
              </WrapPanel>
            </StackPanel>
          </Border>
          <TabControl Grid.Row="1" Name="DocumentTabs" Focusable="True" ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}" AutomationProperties.Name="Documents">
            <TabControl.ItemTemplate>
              <DataTemplate x:DataType="local:Document">
                <TextBlock Text="{Binding Title}" MinHeight="24" />
              </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.DataTemplates>
              <DataTemplate x:DataType="local:HandoffDocument">
                <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="8">
                  <TextBlock Text="Hand-over and resume" FontSize="18" FontWeight="SemiBold" />
                  <StackPanel Grid.Row="1" Spacing="4" Margin="0,6">
                    <SelectableTextBlock MinHeight="24" Text="{Binding Identity}" TextWrapping="Wrap" FontFamily="{DynamicResource BrandMonoFont}" FontSize="11" />
                    <SelectableTextBlock MinHeight="24" Text="{Binding Note}" TextWrapping="Wrap" AutomationProperties.Name="Hand-over outcome" />
                  </StackPanel>
                  <WrapPanel Grid.Row="2" Margin="0,0,0,6">
                    <Button MinHeight="28" Name="PrepareHandoffButton" Content="Prepare new hand-over" Margin="0,0,6,0" Click="OnPrepareHandoff" />
                    <Button MinHeight="28" Name="SaveHandoffButton" Content="Save package…" IsEnabled="{Binding HasPackage}" Margin="0,0,6,0" Click="OnSaveHandoff" />
                    <Button MinHeight="28" Name="LoadHandoffButton" Content="Open package…" Margin="0,0,6,0" Click="OnLoadHandoff" />
                    <Button MinHeight="28" Name="ResumeHandoffButton" Content="Resume: show changes" IsEnabled="{Binding HasPackage}" Click="OnResumeHandoff" />
                  </WrapPanel>
                  <TabControl Name="HandoffViews" Grid.Row="3" AutomationProperties.Name="Hand-over and changes">
                    <TabItem Header="Hand-over">
                      <ScrollViewer>
                        <SelectableTextBlock MinHeight="24" Text="{Binding Text}" TextWrapping="Wrap" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" AutomationProperties.Name="Complete hand-over and originals" />
                      </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Changes since hand-over">
                      <ScrollViewer>
                        <SelectableTextBlock MinHeight="24" Text="{Binding ResumeText}" TextWrapping="Wrap" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" AutomationProperties.Name="Complete resume comparison" />
                      </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Portable package">
                      <ScrollViewer>
                        <SelectableTextBlock MinHeight="24" Text="{Binding PackageJson}" TextWrapping="Wrap" FontFamily="{DynamicResource BrandMonoFont}" FontSize="11" AutomationProperties.Name="Portable hand-over JSON" />
                      </ScrollViewer>
                    </TabItem>
                  </TabControl>
                </Grid>
              </DataTemplate>
              <DataTemplate x:DataType="local:ProductsDocument">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="8">
                    <TextBlock Text="Products" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Opacity="0.8" />
                    <ListBox ItemsSource="{Binding Products}" Focusable="True" AutomationProperties.Name="Products">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ProductRow">
                          <StackPanel MinHeight="32">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Editions}" FontSize="11" Opacity="0.8" />
                            <TextBlock Text="{Binding Surfaces}" FontSize="11" Opacity="0.8" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>
              <DataTemplate x:DataType="local:WorkOrderDocument">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="8">
                    <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <SelectableTextBlock Text="{Binding Communication}" TextWrapping="Wrap" Focusable="True" AutomationProperties.Name="Communication profile" />
                    <TextBlock Text="{Binding Kind2}" Opacity="0.8" />
                    <TextBlock Text="{Binding Intent}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ExitQuestion}" TextWrapping="Wrap" FontStyle="Italic" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Assign…" MinHeight="28" Click="OnOpenComposer" />
                      <Button Content="Open the selected assignment" MinHeight="28" Click="OnOpenSelectedAssignment" />
                      <Button Content="Review the selected result" MinHeight="28" Click="OnReviewSelectedAssignment" />
                      <Button Content="Compare with the earlier revision" MinHeight="28" Click="OnCompareOpen" />
                    </StackPanel>
                    <TextBlock Text="Assignments (Enter opens the assignment)" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Assignments}" SelectedItem="{Binding SelectedAssignment}" Focusable="True" MaxHeight="240" AutomationProperties.Name="Assignments" DoubleTapped="OnOpenSelectedAssignment">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:AssignmentView">
                          <StackPanel MinHeight="32">
                            <TextBlock Text="{Binding Contributor}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="11" />
                            <TextBlock Text="{Binding LatestResultState}" FontSize="11" Opacity="0.8" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Observation" FontWeight="SemiBold" />
                    <SelectableTextBlock MinHeight="24" Text="{Binding Observation}" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>
              <DataTemplate x:DataType="local:AssignmentDocument">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="8">
                    <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Opacity="0.8" />
                    <SelectableTextBlock MinHeight="24" Text="{Binding BriefText}" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" TextWrapping="Wrap" />
                    <Button Content="Review the latest result" MinHeight="28" Click="OnReviewLatestResult" />
                    <TextBlock Text="Attempts (Enter opens the attempt's result for review)" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Attempts}" SelectedItem="{Binding SelectedAttempt}" Focusable="True" MaxHeight="320" AutomationProperties.Name="Attempts" DoubleTapped="OnReviewLatestResult">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:AttemptView">
                          <StackPanel MinHeight="32">
                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>
              <DataTemplate x:DataType="local:AssignmentComposer">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="6" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Nothing is sent until you choose Send; the runtime validates and signs. Lists take one entry per line. Workspaces are described, never as machine paths." TextWrapping="Wrap" Opacity="0.8" />
                    <TextBlock Text="Contributor" />
                    <ComboBox ItemsSource="{Binding Contributors}" SelectedItem="{Binding Contributor}" MinHeight="28" MinWidth="240" AutomationProperties.Name="Contributor">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ContributorRow">
                          <TextBlock Text="{Binding Display}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Outcome" />
                    <TextBox Text="{Binding Outcome}" MinHeight="28" AutomationProperties.Name="Outcome" />
                    <TextBlock Text="Permitted changes" />
                    <TextBox Text="{Binding PermittedChanges}" AcceptsReturn="True" MinHeight="48" AutomationProperties.Name="Permitted changes" />
                    <TextBlock Text="Prohibited effects" />
                    <TextBox Text="{Binding ProhibitedEffects}" AcceptsReturn="True" MinHeight="48" AutomationProperties.Name="Prohibited effects" />
                    <TextBlock Text="Workspace" />
                    <TextBox Text="{Binding Workspace}" AcceptsReturn="True" MinHeight="48" AutomationProperties.Name="Workspace" />
                    <TextBlock Text="Limits" />
                    <TextBox Text="{Binding Limits}" AcceptsReturn="True" MinHeight="48" AutomationProperties.Name="Limits" />
                    <TextBlock Text="Expected outputs" />
                    <TextBox Text="{Binding ExpectedOutputs}" AcceptsReturn="True" MinHeight="48" AutomationProperties.Name="Expected outputs" />
                    <TextBlock Text="Review criteria" />
                    <TextBox Text="{Binding ReviewCriteria}" AcceptsReturn="True" MinHeight="48" AutomationProperties.Name="Review criteria" />
                    <TextBlock Text="Recovery" />
                    <TextBox Text="{Binding Recovery}" MinHeight="28" AutomationProperties.Name="Recovery" />
                    <TextBlock Text="Note" />
                    <TextBox Text="{Binding Note}" MinHeight="28" AutomationProperties.Name="Note" />
                    <Button Content="Send the assignment" MinHeight="32" IsEnabled="{Binding CanSubmit}" Click="OnSubmitAssignment" />
                    <SelectableTextBlock MinHeight="24" Text="{Binding Status}" TextWrapping="Wrap" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" />
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>
              <DataTemplate x:DataType="local:LivingDocumentsWorkspace">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="6" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="Living documents" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Opacity="0.8" />
                    <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Focusable="True" MaxHeight="360" AutomationProperties.Name="Living documents">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:LivingDocumentRow">
                          <StackPanel MinHeight="32">
                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Review the selected document: the runtime reads its content, records what the review answers and runs its declared checks." TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="Outcome" />
                    <ComboBox ItemsSource="{Binding Outcomes}" SelectedItem="{Binding Outcome}" MinHeight="28" AutomationProperties.Name="Outcome" />
                    <TextBlock Text="What was checked" />
                    <TextBox Text="{Binding Summary}" MinHeight="28" AutomationProperties.Name="Summary" />
                    <TextBlock Text="{Binding CommitHint}" />
                    <TextBox Text="{Binding Commit}" MinHeight="28" AutomationProperties.Name="Commit" />
                    <TextBlock Text="Findings, one per line as severity: text" />
                    <TextBox Text="{Binding Findings}" AcceptsReturn="True" MinHeight="56" AutomationProperties.Name="Findings" />
                    <Button Content="Record the review" MinHeight="32" IsEnabled="{Binding CanSubmit}" Click="OnSubmitDocumentReview" />
                    <SelectableTextBlock MinHeight="24" Text="{Binding Status}" TextWrapping="Wrap" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" />
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>
              <DataTemplate x:DataType="local:ResultInboxDocument">
                <StackPanel Margin="8" Spacing="8">
                  <TextBlock Text="Result inbox" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Opacity="0.8" />
                  <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Focusable="True" MaxHeight="480" AutomationProperties.Name="Results awaiting review" DoubleTapped="OnInboxOpen">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="local:InboxRow">
                        <StackPanel MinHeight="32">
                          <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Button Content="Open the review workspace" MinHeight="28" Click="OnInboxOpen" />
                </StackPanel>
              </DataTemplate>
              <DataTemplate x:DataType="local:ReviewWorkspace">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="6" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Prepared.Subject}" FontFamily="{DynamicResource BrandMonoFont}" FontSize="11" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Declaration}" TextWrapping="Wrap" Opacity="0.8" />
                    <SelectableTextBlock MinHeight="24" Text="{Binding SummaryText}" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="Reviews on record (checked ones become the acceptance's basis)" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Reviews}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ReviewRow">
                          <StackPanel Spacing="4">
                            <CheckBox IsChecked="{Binding Selected}" Content="{Binding Display}" MinHeight="28" />
                            <SelectableTextBlock Text="{Binding Findings}" TextWrapping="Wrap" MinHeight="24" Margin="24,0,0,4" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Review" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{x:Static local:ReviewWorkspace.Outcomes}" SelectedItem="{Binding ReviewOutcome}" MinHeight="28" MinWidth="160" AutomationProperties.Name="Review outcome" />
                    <TextBox Text="{Binding ReviewSummary}" AcceptsReturn="True" MinHeight="48" AutomationProperties.Name="Review summary" />
                    <TextBox Text="{Binding ReviewFindings}" AcceptsReturn="True" MinHeight="48" AutomationProperties.Name="Findings, one per line, prefixed error:, warning: or info:" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Send the review" MinHeight="32" IsEnabled="{Binding CanSubmit}" Click="OnSubmitReview" />
                      <Button Content="Check the subject" MinHeight="32" Click="OnCheckPrepared" />
                    </StackPanel>
                    <TextBlock Text="Acceptance" FontWeight="SemiBold" />
                    <TextBox Text="{Binding AcceptanceStatement}" AcceptsReturn="True" MinHeight="48" AutomationProperties.Name="Acceptance statement" />
                    <Button Content="Send the acceptance" MinHeight="32" IsEnabled="{Binding CanSubmit}" Click="OnSubmitAcceptance" />
                    <SelectableTextBlock MinHeight="24" Text="{Binding Status}" TextWrapping="Wrap" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" />
                    <TextBlock Text="{Binding PreparedState}" TextWrapping="Wrap" Opacity="0.8" />
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>
              <DataTemplate x:DataType="local:RuntimeDocument">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="8" MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Text="Runtime" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Where}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Health}" TextWrapping="Wrap" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" />
                    <TextBlock Text="{Binding Acting}" Opacity="0.8" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Start the daemon" MinHeight="28" Click="OnStartRuntime" />
                      <Button Content="Stop the daemon" MinHeight="28" Click="OnStopRuntime" />
                      <Button Content="Show the install plan" MinHeight="28" Click="OnInstallPlan" />
                      <Button Content="Install (after the plan)" MinHeight="28" IsEnabled="{Binding PlanShown}" Click="OnInstallRuntime" />
                      <Button Content="Uninstall (after the plan)" MinHeight="28" IsEnabled="{Binding PlanShown}" Click="OnUninstallRuntime" />
                    </StackPanel>
                    <TextBlock Text="The plan is shown before anything is installed or removed; the command line beside Workbench does both." TextWrapping="Wrap" Opacity="0.8" />
                    <SelectableTextBlock MinHeight="24" Text="{Binding Plan}" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" TextWrapping="Wrap" />
                    <SelectableTextBlock MinHeight="24" Text="{Binding Output}" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" TextWrapping="Wrap" />
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>
              <DataTemplate x:DataType="local:ReleaseWorkspace">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="6" MaxWidth="1000" HorizontalAlignment="Left">
                    <TextBlock Text="Releases" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="A release is intent before effect: the operation is recorded, then the workflow is dispatched; the run, the draft and the publication are observed; the candidate is accepted at its exact hash; publication is your manual step and Workbench never performs it." TextWrapping="Wrap" Opacity="0.8" />
                    <TextBlock Text="Submit" FontWeight="SemiBold" />
                    <TextBlock Text="Version" />
                    <TextBox Text="{Binding Version}" MinHeight="28" Width="240" HorizontalAlignment="Left" AutomationProperties.Name="Version" />
                    <TextBlock Text="Product" />
                    <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding Product}" MinHeight="28" MinWidth="240" AutomationProperties.Name="Product">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="local:ProductRow">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="Provider (the product's declared one is selected; otherwise choose; nothing is selected for you)" TextWrapping="Wrap" />
                    <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" MinHeight="28" MinWidth="240" AutomationProperties.Name="Provider">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="proto:ProviderRow">
                          <TextBlock Text="{Binding Provider}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ItemsControl ItemsSource="{Binding Settings}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:SettingField">
                          <StackPanel Spacing="2" Margin="0,2">
                            <TextBlock Text="{Binding Label}" />
                            <TextBox Text="{Binding Value}" MinHeight="28" Width="360" HorizontalAlignment="Left" AutomationProperties.Name="{Binding Name}" ToolTip.Tip="{Binding Summary}" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Exact commit to build (required in record format 3)" />
                    <TextBox Text="{Binding Commit}" MinHeight="28" AutomationProperties.Name="Commit" />
                    <TextBlock Text="The runtime checks this commit and the selected product revision again before dispatch. A refusal shows every hold; retained evidence can be opened with release basis." TextWrapping="Wrap" Opacity="0.8" />
                    <TextBlock Text="Reconciliation (required for a retry after a failed, canceled or uncertain attempt)" />
                    <TextBox Text="{Binding Reconciliation}" MinHeight="28" AutomationProperties.Name="Reconciliation" />
                    <Button Content="Submit the release (intent, then dispatch)" MinHeight="32" IsEnabled="{Binding CanSubmit}" Click="OnSubmitRelease" />
                    <TextBlock Text="Destinations (Enter opens the candidate for acceptance)" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Destinations}" SelectedItem="{Binding Selected}" Focusable="True" MaxHeight="240" AutomationProperties.Name="Release destinations">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:DestinationRow">
                          <StackPanel MinHeight="32">
                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Observe the selected destination" FontWeight="SemiBold" />
                    <TextBlock Text="Qualified platforms, one per line (recorded on the candidate)" />
                    <TextBox Text="{Binding Qualified}" AcceptsReturn="True" MinHeight="48" AutomationProperties.Name="Qualified platforms" />
                    <TextBlock Text="Known limitations, one per line" />
                    <TextBox Text="{Binding Limitations}" AcceptsReturn="True" MinHeight="48" AutomationProperties.Name="Limitations" />
                    <TextBlock Text="Signing state" />
                    <TextBox Text="{Binding Signing}" MinHeight="28" Width="360" HorizontalAlignment="Left" AutomationProperties.Name="Signing" />
                    <TextBlock Text="Cancel reason (settles an intent never dispatched or an outcome reconciled as having had no effect)" />
                    <TextBox Text="{Binding CancelReason}" MinHeight="28" AutomationProperties.Name="Cancel reason" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Observe the run, the draft and the publication" MinHeight="32" Click="OnObserveRelease" />
                      <Button Content="Accept the candidate…" MinHeight="32" Click="OnAcceptCandidate" />
                    </StackPanel>
                    <TextBlock Text="Publish by hand (Workbench never runs this):" FontWeight="SemiBold" />
                    <SelectableTextBlock MinHeight="24" Text="{Binding Publish}" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="Release records (Enter opens one for acceptance)" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Releases}" Focusable="True" MaxHeight="200" AutomationProperties.Name="Release records">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="pres:ReleaseRowView">
                          <StackPanel MinHeight="32">
                            <TextBlock Text="{Binding Version}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusLabel}" FontSize="11" Opacity="0.8" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <SelectableTextBlock MinHeight="24" Text="{Binding Status}" TextWrapping="Wrap" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" />
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>
              <DataTemplate x:DataType="local:ComparisonDocument">
                <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,*,*" Margin="8">
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding LeftTitle}" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Summary}" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding RightTitle}" FontWeight="SemiBold" />
                  <ScrollViewer Grid.Row="1" Grid.Column="0">
                    <SelectableTextBlock MinHeight="24" Text="{Binding LeftText}" FontFamily="{DynamicResource BrandMonoFont}" FontSize="11" />
                  </ScrollViewer>
                  <ScrollViewer Grid.Row="1" Grid.Column="1">
                    <SelectableTextBlock MinHeight="24" Text="{Binding DiffText}" FontFamily="{DynamicResource BrandMonoFont}" FontSize="11" />
                  </ScrollViewer>
                  <ScrollViewer Grid.Row="1" Grid.Column="2">
                    <SelectableTextBlock MinHeight="24" Text="{Binding RightText}" FontFamily="{DynamicResource BrandMonoFont}" FontSize="11" />
                  </ScrollViewer>
                </Grid>
              </DataTemplate>
              <DataTemplate x:DataType="local:TextDocument">
                <ScrollViewer>
                  <SelectableTextBlock MinHeight="24" Text="{Binding Text}" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" Margin="8" TextWrapping="Wrap" />
                </ScrollViewer>
              </DataTemplate>
              <DataTemplate x:DataType="local:GoalsWorkspace">
                <ScrollViewer>
                  <StackPanel Margin="8" Spacing="6" MaxWidth="1000" HorizontalAlignment="Left">
                    <TextBlock Text="Goals" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" Opacity="0.8" />
                    <ListBox ItemsSource="{Binding Goals}" SelectedItem="{Binding Selected}" Focusable="True" MaxHeight="200" AutomationProperties.Name="Goals">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="pres:GoalListRow">
                          <StackPanel MinHeight="32">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Heading}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="Objective" FontWeight="SemiBold" />
                    <SelectableTextBlock MinHeight="24" Text="{Binding Objective}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Acceptance}" TextWrapping="Wrap" Opacity="0.8" />
                    <TextBlock Text="Conditions, with their current verdicts" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Conditions}" Focusable="True" MaxHeight="240" AutomationProperties.Name="Conditions">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="pres:ConditionRow">
                          <StackPanel MinHeight="32">
                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Plan and steps, with the principal each reaches from the runtime's machine" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Steps}" Focusable="True" MaxHeight="320" AutomationProperties.Name="Steps">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="pres:StepRow">
                          <StackPanel MinHeight="32">
                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding Next}" TextWrapping="Wrap" />
                    <TextBlock Text="Spend against the budget, from the agent-run ledger" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Spend}" Focusable="True" MaxHeight="200" AutomationProperties.Name="Spend">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="pres:SpendRow">
                          <Grid ColumnDefinitions="120,*" MinHeight="32">
                            <TextBlock Grid.Column="0" Text="{Binding Unit}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding Detail}" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Asks, the recommendation first" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Asks}" Focusable="True" MaxHeight="240" AutomationProperties.Name="Asks">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="pres:AskRow">
                          <StackPanel MinHeight="32">
                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Evaluations" FontWeight="SemiBold" />
                    <ListBox ItemsSource="{Binding Evaluations}" Focusable="True" MaxHeight="200" AutomationProperties.Name="Evaluations">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="pres:EvaluationRow">
                          <StackPanel MinHeight="32">
                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Summary}" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>
              <DataTemplate x:DataType="local:CommunicationDocument">
                <ScrollViewer>
                  <StackPanel Margin="12" Spacing="8">
                    <TextBlock Text="Communication settings" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Choose a scope and recipient, then refresh before editing. Inherit uses the next applicable source. Required attention and complete originals remain available at every setting." TextWrapping="Wrap" />
                    <TextBlock Text="Scope" />
                    <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" MinWidth="180" AutomationProperties.Name="Communication scope" />
                    <TextBox Text="{Binding Recipient}" PlaceholderText="Recipient principal id" AutomationProperties.Name="Communication recipient" />
                    <TextBox Text="{Binding Assignment}" PlaceholderText="Assignment id (assignment scope only)" AutomationProperties.Name="Communication assignment" />
                    <TextBox Text="{Binding Authority}" PlaceholderText="Delegation record id (when changing another person's setting)" AutomationProperties.Name="Communication delegation" />
                    <Button Content="Refresh this scope" Click="OnRefreshCommunication" HorizontalAlignment="Left" />
                    <TextBlock Text="Progress frequency" />
                    <ComboBox ItemsSource="{Binding Frequencies}" SelectedItem="{Binding ProgressFrequency}" MinWidth="240" AutomationProperties.Name="Progress frequency" />
                    <TextBlock Text="Status depth" />
                    <ComboBox ItemsSource="{Binding Depths}" SelectedItem="{Binding StatusDepth}" MinWidth="180" AutomationProperties.Name="Status depth" />
                    <TextBlock Text="Decision depth" />
                    <ComboBox ItemsSource="{Binding Depths}" SelectedItem="{Binding DecisionDepth}" MinWidth="180" AutomationProperties.Name="Decision depth" />
                    <TextBlock Text="Result depth" />
                    <ComboBox ItemsSource="{Binding Depths}" SelectedItem="{Binding ResultDepth}" MinWidth="180" AutomationProperties.Name="Result depth" />
                    <TextBlock Text="Handoff depth" />
                    <ComboBox ItemsSource="{Binding Depths}" SelectedItem="{Binding HandoffDepth}" MinWidth="180" AutomationProperties.Name="Handoff depth" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Content="Save this scope" IsEnabled="{Binding CanSubmit}" Click="OnSaveCommunication" />
                      <Button Content="Reset this scope to inheritance" IsEnabled="{Binding CanSubmit}" Click="OnResetCommunication" />
                    </StackPanel>
                    <SelectableTextBlock MinHeight="24" Text="{Binding Note}" TextWrapping="Wrap" Focusable="True" AutomationProperties.Name="Communication write outcome" />
                    <TextBlock Text="Recorded values and sources" FontWeight="SemiBold" />
                    <SelectableTextBlock Text="{Binding Effective}" TextWrapping="Wrap" Focusable="True" />
                    <TextBlock Text="Preview of this draft" FontWeight="SemiBold" />
                    <SelectableTextBlock Text="{Binding Preview}" TextWrapping="Wrap" Focusable="True" AutomationProperties.Name="Communication preview" />
                  </StackPanel>
                </ScrollViewer>
              </DataTemplate>
              <DataTemplate x:DataType="local:ProgressDocument">
                <ScrollViewer>
                  <SelectableTextBlock MinHeight="24" Text="{Binding Text}" FontFamily="{DynamicResource BrandMonoFont}" FontSize="12" Margin="8" TextWrapping="Wrap" Focusable="True" AutomationProperties.Name="Progress report" />
                </ScrollViewer>
              </DataTemplate>
            </TabControl.DataTemplates>
          </TabControl>
        </Grid>
      </Grid>

      <GridSplitter Name="RightSplitter" Grid.Column="3" Grid.Row="0" Grid.RowSpan="3" Width="4" IsVisible="{Binding RightVisible}" />
      <Border Name="RightPanel" Grid.Column="4" Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding RightVisible}" Padding="8" AutomationProperties.Name="Inspector">
        <ScrollViewer>
          <SelectableTextBlock MinHeight="24" Name="InspectorText" Text="{Binding Inspector}" TextWrapping="Wrap" Focusable="True" AutomationProperties.Name="Inspector text" />
        </ScrollViewer>
      </Border>

      <GridSplitter Name="BottomSplitter" Grid.Column="2" Grid.Row="1" Height="4" IsVisible="{Binding BottomVisible}" />
      <Border Name="BottomPanel" Grid.Column="2" Grid.Row="2" IsVisible="{Binding BottomVisible}" AutomationProperties.Name="Activity">
        <ListBox Name="ActivityList" Focusable="True" ItemsSource="{Binding Activity}" FontFamily="{DynamicResource BrandMonoFont}" FontSize="11" AutomationProperties.Name="Activity log" />
      </Border>
    </Grid>
  </DockPanel>
</Window>
