<!-- The brand's token contract (design/brand.md revision 2): the shell binds these roles, never values. The first values were
     adopted by the operator's decision of October 14, 2026; light and dark variants are both bound so the shell follows the
     platform, and the probe measures the contrast of every pair the roles form. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BrandSurface" Color="#FAFAFA" />
      <SolidColorBrush x:Key="BrandSurfaceRaised" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BrandText" Color="#1A1A1A" />
      <SolidColorBrush x:Key="BrandTextMuted" Color="#5C5C5C" />
      <SolidColorBrush x:Key="BrandAccent" Color="#2F5F8F" />
      <SolidColorBrush x:Key="BrandAccentText" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BrandAttention" Color="#8A4B00" />
      <SolidColorBrush x:Key="BrandOutline" Color="#767676" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BrandSurface" Color="#1E1E1E" />
      <SolidColorBrush x:Key="BrandSurfaceRaised" Color="#2A2A2A" />
      <SolidColorBrush x:Key="BrandText" Color="#EAEAEA" />
      <SolidColorBrush x:Key="BrandTextMuted" Color="#A8A8A8" />
      <SolidColorBrush x:Key="BrandAccent" Color="#7FB2E5" />
      <SolidColorBrush x:Key="BrandAccentText" Color="#101010" />
      <SolidColorBrush x:Key="BrandAttention" Color="#F0B46A" />
      <SolidColorBrush x:Key="BrandOutline" Color="#8F8F8F" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Type roles: title, heading, body, mono. Inter and JetBrains Mono travel with Workbench under the SIL Open Font License
       (Assets/Fonts); identifiers, hashes and commands are never shown in a proportional face. -->
  <FontFamily x:Key="BrandTitleFont">avares://vericairn-workbench/Assets/Fonts#Inter</FontFamily>
  <FontFamily x:Key="BrandHeadingFont">avares://vericairn-workbench/Assets/Fonts#Inter</FontFamily>
  <FontFamily x:Key="BrandBodyFont">avares://vericairn-workbench/Assets/Fonts#Inter</FontFamily>
  <FontFamily x:Key="BrandMonoFont">avares://vericairn-workbench/Assets/Fonts#JetBrains Mono</FontFamily>

  <!-- Scale roles: compact is the density the accessibility measurement is taken at. -->
  <x:Double x:Key="BrandScaleCompact">12</x:Double>
  <x:Double x:Key="BrandScaleComfortable">14</x:Double>
  <x:Double x:Key="BrandScaleLarge">16</x:Double>

  <!-- Motion roles, in milliseconds; both reduce to none under the platform's reduced-motion setting and no motion carries meaning on its own. -->
  <x:Double x:Key="BrandMotionRevealMilliseconds">120</x:Double>
  <x:Double x:Key="BrandMotionSettleMilliseconds">200</x:Double>
</ResourceDictionary>
