<!-- The brand's token contract (design/brand.md): the shell binds these roles, never values. The values are neutral placeholders
     until the operator's direction becomes revision 2; light and dark variants are both bound so the shell follows the platform. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="BrandSurface" Color="#FAFAFA" />
      <SolidColorBrush x:Key="BrandSurfaceRaised" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BrandText" Color="#1A1A1A" />
      <SolidColorBrush x:Key="BrandTextMuted" Color="#5C5C5C" />
      <SolidColorBrush x:Key="BrandAccent" Color="#2F5F8F" />
      <SolidColorBrush x:Key="BrandAccentText" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BrandAttention" Color="#8A4B00" />
      <SolidColorBrush x:Key="BrandOutline" Color="#C9C9C9" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="BrandSurface" Color="#1E1E1E" />
      <SolidColorBrush x:Key="BrandSurfaceRaised" Color="#2A2A2A" />
      <SolidColorBrush x:Key="BrandText" Color="#EAEAEA" />
      <SolidColorBrush x:Key="BrandTextMuted" Color="#A8A8A8" />
      <SolidColorBrush x:Key="BrandAccent" Color="#7FB2E5" />
      <SolidColorBrush x:Key="BrandAccentText" Color="#101010" />
      <SolidColorBrush x:Key="BrandAttention" Color="#F0B46A" />
      <SolidColorBrush x:Key="BrandOutline" Color="#4A4A4A" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Type roles: title, heading, body, mono. Identifiers, hashes and commands are never shown in a proportional face. -->
  <FontFamily x:Key="BrandTitleFont">Inter,Segoe UI,Helvetica Neue,sans-serif</FontFamily>
  <FontFamily x:Key="BrandHeadingFont">Inter,Segoe UI,Helvetica Neue,sans-serif</FontFamily>
  <FontFamily x:Key="BrandBodyFont">Inter,Segoe UI,Helvetica Neue,sans-serif</FontFamily>
  <FontFamily x:Key="BrandMonoFont">Menlo,Consolas,DejaVu Sans Mono,monospace</FontFamily>

  <!-- Scale roles: compact is the density the accessibility measurement is taken at. -->
  <x:Double x:Key="BrandScaleCompact">12</x:Double>
  <x:Double x:Key="BrandScaleComfortable">14</x:Double>
  <x:Double x:Key="BrandScaleLarge">16</x:Double>

  <!-- Motion roles, in milliseconds; both reduce to none under the platform's reduced-motion setting and no motion carries meaning on its own. -->
  <x:Double x:Key="BrandMotionRevealMilliseconds">120</x:Double>
  <x:Double x:Key="BrandMotionSettleMilliseconds">200</x:Double>
</ResourceDictionary>
