<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Vericairn record format: canonical JSON, identifiers, hashing, validation and estate layout.</Description>
    <IsPackable>true</IsPackable>
    <PackageId>Vericairn.Records</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Shared/PresentationContent.cs" Link="Templates/PresentationContent.cs" />
    <Compile Include="../Shared/PresentationContracts.cs" Link="Templates/PresentationContracts.cs" />
    <InternalsVisibleTo Include="Vericairn.Records.Tests" />
    <InternalsVisibleTo Include="Vericairn.Runtime.Tests" />
    <InternalsVisibleTo Include="Vericairn.Runtime" />
    <InternalsVisibleTo Include="Vericairn.Cli.Tests" />
    <InternalsVisibleTo Include="vericairn" />
    <InternalsVisibleTo Include="vericairn-workbench" />
    <InternalsVisibleTo Include="Vericairn.Workbench.Tests" />
    <InternalsVisibleTo Include="Vericairn.Remote.Tests" />
    <InternalsVisibleTo Include="Vericairn.Sdk" />
  </ItemGroup>

  <ItemGroup>
    <!-- Text/UnicodeFolding.Tables.cs is derived from Unicode data files, whose license travels with the package. -->
    <None Include="../../licenses/Unicode-3.0.txt" Pack="true" PackagePath="/licenses/" />
  </ItemGroup>

</Project>
