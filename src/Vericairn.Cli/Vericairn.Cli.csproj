<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>vericairn</AssemblyName>
    <RootNamespace>Vericairn.Cli</RootNamespace>
    <Description>The vericairn command-line interface.</Description>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <PackageId>dotnet-vc</PackageId>
    <ToolCommandName>dotnet-vc</ToolCommandName>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vericairn.Cli.Tests" />
    <InternalsVisibleTo Include="Vericairn.Workbench.Tests" />
    <InternalsVisibleTo Include="vericairn-docs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Vericairn.Records/Vericairn.Records.csproj" />
    <ProjectReference Include="../Vericairn.Runtime/Vericairn.Runtime.csproj" />
    <ProjectReference Include="../Vericairn.Daemon/Vericairn.Daemon.csproj" />
    <ProjectReference Include="../Vericairn.Protocol/Vericairn.Protocol.csproj" />
    <ProjectReference Include="../Vericairn.Sdk/Vericairn.Sdk.csproj" />
    <ProjectReference Include="../Vericairn.Mcp/Vericairn.Mcp.csproj" />
    <ProjectReference Include="../Vericairn.Providers.GitHub/Vericairn.Providers.GitHub.csproj" />
    <ProjectReference Include="../Vericairn.Adapters.Git/Vericairn.Adapters.Git.csproj" />
    <ProjectReference Include="../Vericairn.Packs.Software/Vericairn.Packs.Software.csproj" />
  </ItemGroup>

</Project>
