# Build output (UseArtifactsOutput puts everything here)
artifacts/
bin/
obj/
TestResults/

# Per-clone working state and local tooling; never estate content
.vericairn/

# IDE and OS residue
.vs/
.idea/
*.user
*.suo
.DS_Store

# Python byte caches, such as those the packaging checker's tests write under tools/, are never sources.
__pycache__/
