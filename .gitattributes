# Text files are LF in the repository and in every working tree, on every platform.
* text=auto eol=lf
*.cs text eol=lf
*.csproj text eol=lf
*.slnx text eol=lf
*.props text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Binary assets never get line-ending conversion.
*.png binary
*.jpg binary
*.ico binary
*.icns binary
*.woff2 binary
